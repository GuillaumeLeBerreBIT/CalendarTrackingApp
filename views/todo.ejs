<%- include('partials/header.ejs') %>
<body class="app-page">
<%- include('partials/navbar.ejs') %>
<main>
    <div class="todo-header-container">
        <h1>Todo Lists</h1>

        <div class="center-vertical">
            <input id="search-task" type="search" placeholder="Search task" class="flex-shrink">
            <div class="justify-between gap-5 fixed-item">
                <select name="filter" id="select-tasks">
                    <option value="all">All Tasks</option>
                    <option value="active">Active</option>
                    <option value="completed">Completed</option>
                    <option value="to-me">Assigned to Me</option>
                </select>
                <button class="h-100" id="btn-new-list">New List</button>
            </div>
        </div>
    </div>

    <!--Show Groups with list items-->
    <div class="group-container">
        <% if (yourTaskLists.length === 0) { %>
            <div class="empty-state-box" style="width: 100%; padding: 64px 24px;">
                <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="currentColor" style="color: var(--color-text-3, #9ca3af)"><path d="M200-200v-560 454-85 191Zm0 80q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v320h-80v-320H200v560h280v80H200Zm494 40L552-222l57-56 85 85 170-170 56 57L694-80ZM320-440q17 0 28.5-11.5T360-480q0-17-11.5-28.5T320-520q-17 0-28.5 11.5T280-480q0 17 11.5 28.5T320-440Zm0-160q17 0 28.5-11.5T360-640q0-17-11.5-28.5T320-680q-17 0-28.5 11.5T280-640q0 17 11.5 28.5T320-600Zm120 160h240v-80H440v80Zm0-160h240v-80H440v80Z"/></svg>
                <p style="color: var(--color-text-3, #9ca3af); margin-top: 12px; font-size: 15px;">No task lists yet.</p>
                <p style="color: var(--color-text-3, #9ca3af);">Click "New List" above to create your first task list.</p>
            </div>
        <% } else { yourTaskLists.forEach(taskList=> { %>

            <div class="group-card card-shape" data-task-list-id="<%= taskList.taskListInfo.idTl %>"
                data-group-id="<%= taskList.taskListInfo.idG %>">
                <div class="group-header">
                    <input type="hidden">
                    <div class="justify-start gap-20">
                        <h3 id="task-list-title">
                            <%= taskList.taskListInfo.title %>
                        </h3>
                        <div class="badge-secondary">
                            <%= taskList.taskListInfo.tag_group %>
                        </div>
                    </div>

                    <div class="header-item">
                        <button class="btn btn-soft add-task-btn" id="add-task-btn"
                            data-task-list-id="<%= taskList.taskListInfo.idTl %>">
                            Add Task
                        </button>
                        <button class="btn btn-soft">...</button>
                    </div>
                </div>
                <p>
                    <%= taskList.taskListInfo.desc %>
                </p>
                <div class="progress-section">
                    <% if (taskList.taskItems.length !== 0) {%>
                    <div class="justify-between">
                        <span class="progress-bar-text">Progress</span>
                        <span class="progress-bar-prog"><%= taskList.totalCompletedTasks %> of <%= taskList.totalTasks %> completed</span>
                    </div>
                    <div class="progress-container" role="progressbar" aria-valuenow="<%= taskList.totalCompletedTasks %>" aria-valuemax="<%= taskList.totalTasks %>">
                        <div class="progress" 
                        <% /* eslint-disable css-propertyvalueexpected */ %>
                        style="width: <%= taskList.progressWidth %>%"></div>
                    </div>
                    <% }%>
                </div>

                <div class="task-container" id="task-container">
                    <% if (taskList.taskItems.length !==0) {taskList.taskItems.forEach(t=> { %>
                        <div class="task-card card-shape" data-task-id="<%= t.task_id %>">
                            <div class="radio-box">
                                <input type="checkbox" class="task-completion" name="task-completion" 
                                 data-task-id="<%= t.task_id%>"
                                <% if (t.is_completed) {%>checked<%}%>>
                            </div>
                            <div class="task-content">
                                <div class="justify-between">
                                    <h4>
                                        <%= t.task_title %>
                                    </h4>
                                    <div class="task-actions">
                                        <span class="badge-secondary">
                                            <%= t.priority %>
                                        </span>
                                        <button class="edit-task" type="button"
                                            data-task-id="<%= t.task_id %>"
                                            data-task-title="<%= t.task_title %>"
                                            data-task-description="<%= t.task_description || '' %>"
                                            data-priority="<%= t.priority %>"
                                            data-due-date="<%= t.due_date || '' %>"
                                            data-task-list-id="<%= taskList.taskListInfo.idTl %>">✏
                                        </button>
                                    </div>
                                </div>
                                <% if (t.task_Description) { %>
                                <p>
                                    <%= t.task_description %>
                                </p>
                                <% } %>
                                <%if (t?.due_date || t.profiles_task.length >= 1) {%>
                                    <div>
                                        <% if (t?.due_date) {%>
                                            <span>Due <%= new Date(t.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                                        <%} %>
                                        <div id="assigned-members" class="justify-start gap-5">
                                            <%if (t.profiles_task) {%>
                                                <%t.profiles_task.forEach((m) => {%>
                                                    <div class="badge-secondary" data-user-id="<%=m.user_id%>">
                                                        <%= m.profiles.username %>
                                                    </div>
                                            <%})}%>
                                        </div>
                                    </div>
                                <%}%>
                            </div>
                        </div>
                    <%})} else { %>
                        <p class="empty-state" style="text-align: center; color: #999; padding: 20px;">
                            No tasks yet. Click "Add Task" to get started.
                        </p>
                    <%}; %>
                </div>
            </div>
        <%}); } %>
    </div>

    <div class="modal-overlay" id="modal-overlay-new-list">
        <div class="modal-box">
            <span class="close-btn" id="close-btn">&times;</span>

            <form method="post" action="/createTaskList" class="form-modal" id="task-list-form">

                <div class="flex-column">
                    <label for="task_list_title">Title</label>
                    <input name="title" id="task_list_title" type="text" placeholder="Title" required>
                </div>
                <div class="flex-column">
                    <label for=tag_name>Tag</label>
                    <select name="group-tags" id="tag_name">
                        <% groupTagObj.forEach((t)=> {%>
                            <option value="<%= t.gid %>">
                                <%= t.tag %>
                            </option>
                            <% })%>
                    </select>
                </div>
                <div class="flex-column">
                    <label for="task_list_descr">Description</label>
                    <textarea name="description" id="task_list_descr" rows="5" cols="33"
                        placeholder="Context about the tasks entered in this list."></textarea>
                </div>

                <input type="hidden" name="groups_id" id="groups_id" value="">

                <input type="submit" class="task-list-submit" id="task-list-submit">
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="modal-overlay-new-task">
        <div class="modal-box">
            <span class="close-btn" id="close-btn-task">&times;</span>
            <div class="flex-column">
                <h3 id="task-modal-title">New Task</h3>
                <form method="post" class="form-modal w-100" id="task-form">

                    <div class="flex-column">
                        <label for="">Title</label>
                        <input type="text" name="task_title" class="" id="task_title" placeholder="">
                    </div>
                    <div class="flex-column">
                        <label for="">Task Description</label>
                        <input type="text" name="task_description" class="" id="task_description" placeholder="">
                    </div>
                    <div class="flex-column">
                        <label for="">Priority</label>
                        <select type="text" name="priority" class="" id="task_priority">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                    <div class="flex-column">
                        <label for="">Due Date</label>
                        <input type="date" name="due_date" class="" id="task_due_date">
                    </div>
                    <div class="flex-column">
                        <label for="assign-member">Assign members</label>
                        <div id="assign-member-container" class="card-shape participants-box">
                            
                        </div>
                    </div>

                    <input type="hidden" name="task_id" id="task_id" value="">
                    <input type="hidden" name="task_list_id" id="task_list_id" value="">
                    <input type="submit" class="btn-task-submit" id="btn-task-submit" value="Add Task">
                </form>
            </div>
        </div>
    </div>

    <template id="task-list-template">
        <div class="group-card card-shape">
            <div class="group-header">
                <div class="justify-start gap-20">
                    <h3 class="task-list-title"></h3>
                    <div class="badge-secondary task-list-tag"></div>
                </div>
                <div class="header-item">
                    <button class="btn btn-soft add-task-btn">Add Task</button>
                    <button class="btn btn-soft">...</button>
                </div>
            </div>
            <p class="task-list-description"></p>
            <div class="progress-section"></div>
            <div class="task-container">
                <p class="empty-state" style="text-align: center; color: #999; padding: 20px;">
                    No tasks yet. Click "Add Task" to get started.
                </p>
            </div>
        </div>
    </template>

    <template id="task-template">
        <div class="task-card card-shape">
            <div class="radio-box">
                <input type="checkbox" name="task-completion" id="task-completion">
            </div>
            <div class="task-content">
                <div class="justify-between">
                    <h4 id="task-title"></h4>
                    <div class="task-actions">
                        <span id="task-priority"></span>
                        <button class="btn-edit-task" type="button">✏</button>
                    </div>
                </div>
                <p id="task-description"></p>
                <div>
                    <span id="task-deadline">No deadline</span>
                    <div id="assigned-members" class="justify-start gap-5">

                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="progress-template">
        <div class="justify-between">
            <span class="progress-bar-text">Progress</span>
            <span class="progress-bar-prog"></span>
        </div>
        <div class="progress-container" role="progressbar">
            <div class="progress"
            <% /* eslint-disable css-propertyvalueexpected */ %>
            </div>
        </div>
    </template>

    <meta name="current-user-id" content="<%= locals.currentUserId || '' %>">

    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.18/index.global.min.js'></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.11.0/dist/axios.min.js"></script>
    <script src="js/todo.js"></script>
    <%- include('partials/footer.ejs') %>